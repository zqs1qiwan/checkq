root = true

# 全仓库统一：UTF-8、LF、末尾换行、去行尾空白、2 空格缩进。
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 用行尾两个空格表示换行，不裁剪
trim_trailing_whitespace = false

[*.{yml,yaml,json,js,jsx,cjs,mjs,css,html}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
end_of_line = lf

[*.{ps1,psm1}]
end_of_line = crlf
